# Application environment (copy to .env and adjust as needed)
APP_ENV=development
LOG_LEVEL=INFO

# Path to the local SQLite database
# DB_PATH=data/life_agent.db

# --- LLM provider (OpenAI-compatible) ---------------------------------------
# Required. The agent is driven by a language model: without all three of these
# it cannot understand anything you type. Any OpenAI-compatible endpoint works
# — OpenAI, OpenRouter, or a local server such as Ollama or llama.cpp.
#
# Do NOT commit real API keys.
#
# A weak model will misclassify and occasionally claim to have saved something
# it has not. Use a capable one; see docs/llm-first-pivot.md.
LIFE_AGENT_LLM_PROVIDER=openai_compatible
LIFE_AGENT_LLM_BASE_URL=https://api.openai.com/v1
LIFE_AGENT_LLM_API_KEY=sk-your-key-here
LIFE_AGENT_LLM_MODEL=gpt-4o
