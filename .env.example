# Application environment (copy to .env and adjust as needed)
APP_ENV=development
LOG_LEVEL=INFO

# Path to the local SQLite database
# DB_PATH=data/life_agent.db

# --- Natural language extraction -------------------------------------------
# Extraction mode: "deterministic" (default, fully offline) or "llm".
# The app works without any of the LLM_* variables below.
LIFE_AGENT_EXTRACTION_MODE=deterministic

# --- Optional LLM provider (OpenAI-compatible) -----------------------------
# Only used when LIFE_AGENT_EXTRACTION_MODE=llm. Works with OpenAI, OpenRouter,
# or any OpenAI-compatible endpoint. Leave unset to stay fully offline.
# Do NOT commit real API keys.
LIFE_AGENT_LLM_PROVIDER=openai_compatible
# LIFE_AGENT_LLM_BASE_URL=https://api.openai.com/v1
# LIFE_AGENT_LLM_API_KEY=sk-your-key-here
# LIFE_AGENT_LLM_MODEL=gpt-4o-mini
